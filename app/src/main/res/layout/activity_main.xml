<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_dark" android:padding="24dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BlurCache Manager" android:textSize="28sp" android:textColor="@color/text_primary" android:textStyle="bold" android:layout_marginBottom="8dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="模糊缓存管理系统" android:textSize="14sp" android:textColor="@color/text_muted" android:layout_marginBottom="32dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@color/surface_dark" android:padding="20dp" android:layout_marginBottom="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="状态" android:textSize="12sp" android:textColor="@color/text_muted" android:layout_marginBottom="8dp" />
            <TextView android:id="@+id/tv_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="待机中" android:textSize="18sp" android:textColor="@color/accent" android:textStyle="bold" android:layout_marginBottom="16dp" />
            <TextView android:id="@+id/tv_cache_size" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="缓存大小: --" android:textSize="12sp" android:textColor="@color/text_muted" android:layout_marginBottom="4dp" />
            <TextView android:id="@+id/tv_wallpaper_hash" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="壁纸 Hash: --" android:textSize="12sp" android:textColor="@color/text_muted" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_generate" android:layout_width="match_parent" android:layout_height="56dp" android:text="立即生成缓存" android:textSize="16sp" android:layout_marginBottom="12dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_start_service" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="56dp" android:text="启动监听服务" android:textSize="16sp" android:layout_marginBottom="12dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_stop_service" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="56dp" android:text="停止监听服务" android:textSize="16sp" android:layout_marginBottom="32dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="运行日志" android:textSize="12sp" android:textColor="@color/text_muted" android:layout_marginBottom="8dp" />
        <TextView android:id="@+id/tv_log" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="等待操作..." android:textSize="11sp" android:textColor="@color/text_muted" android:fontFamily="monospace" android:lineSpacingExtra="4dp" android:background="@color/surface_dark" android:padding="12dp" />
    </LinearLayout>
</ScrollView>
